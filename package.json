{
  "name": "hexa",
  "version": "0.1.0",
  "description": "Hexa, a Linux-native desktop companion who narrates what Claude Code is doing.",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "keywords": [
    "claude-code",
    "desktop-pet",
    "linux",
    "electron",
    "x11",
    "kde"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test \"tests/**/*.test.*js\"",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/hooks.js install",
    "hooks:uninstall": "node scripts/hooks.js uninstall",
    "icons": "electron tools/make-icons.js",
    "live:m2": "tools/live/hidden-desktop.sh node tools/live/m2.js",
    "live:menu": "tools/live/hidden-desktop.sh node tools/live/menu.js",
    "test:x": "tools/live/hidden-desktop.sh env HEXA_TEST_X=1 node --test tests/x11.test.js tests/windows-x11.test.js",
    "live:hud": "tools/live/hidden-desktop.sh node tools/live/hud.js",
    "live:permission": "tools/live/hidden-desktop.sh node tools/live/permission.js",
    "live:fork": "tools/live/hidden-desktop.sh node tools/live/fork.js",
    "live:brain": "tools/live/hidden-desktop.sh node tools/live/brain.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "dbus-next": "0.10.2",
    "x11": "4.3.1"
  },
  "devDependencies": {
    "electron": "44.7.1"
  }
}
